  "color": {
    "$description": "Couleurs sémantiques — le vocabulaire à employer dans le code.",
    "primary": {
      "$type": "color",
      "$value": "#0D5AB7",
      "$description": "Accent interactif principal — CTA, liens, état actif."
    },
    "primaryDark": {
      "$type": "color",
      "$value": "#073B6F",
      "$description": "Variante foncée de primary — état pressé, survol."
    },
    "brand": {
      "$type": "color",
      "$value": "#00295B",
      "$description": "Surface de marque dominante — en-têtes, blocs héros."
    },
    "accent": {
      "$type": "color",
      "$value": "#FFA522",
      "$description": "Mise en avant, attention — à réserver aux éléments qui doivent capter l'œil."
    },
    "success": {
      "$type": "color",
      "$value": "#17A679",
      "$description": "État de réussite — validation, conformité, synchronisation terminée."
    },
    "successBg": {
      "$type": "color",
      "$value": "#DFF7F3",
      "$description": "Fond des éléments en état de réussite (pastilles, bandeaux)."
    },
    "danger": {
      "$type": "color",
      "$value": "#BE3A37",
      "$description": "État de danger — erreur, écart bloquant, action destructrice."
    },
    "dangerBg": {
      "$type": "color",
      "$value": "#F1C0C1",
      "$description": "Fond des éléments en état de danger."
    },
    "warning": {
      "$type": "color",
      "$value": "#FFA522",
      "$description": "État de vigilance — information à confirmer, écart non bloquant."
    },
    "bg": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Fond de page par défaut."
    },
    "bgSubtle": {
      "$type": "color",
      "$value": "#FCFDFE",
      "$description": "En-tête de section, de tableau, du rail — presque blanc. Détache l'en-tête de son contenu sans grisser l'écran."
    },
    "bgMuted": {
      "$type": "color",
      "$value": "#F6F7F9",
      "$description": "Fond secondaire — sections, cartes posées sur le fond de page."
    },
    "border": {
      "$type": "color",
      "$value": "#C8D3DA",
      "$description": "Bordures et séparateurs."
    },
    "borderSoft": {
      "$type": "color",
      "$value": "#EAEEF1",
      "$description": "Bordure discrète — séparateurs internes, contour de carte."
    },
    "text": {
      "$type": "color",
      "$value": "#232B2F",
      "$description": "Texte courant."
    },
    "textMuted": {
      "$type": "color",
      "$value": "#5D6D79",
      "$description": "Texte secondaire — libellés, métadonnées."
    },
    "textSubtle": {
      "$type": "color",
      "$value": "#8094A3",
      "$description": "Texte tertiaire — placeholders, texte désactivé."
    },
    "textOnDark": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Texte posé sur une surface foncée (brand, primary)."
    },
    "black": {
      "$type": "color",
      "$value": "#000000",
      "$description": "Noir pur — overlays, ombres. Éviter pour du texte, préférer `text`."
    }
  },
