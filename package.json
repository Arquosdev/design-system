{
  "name": "@arquos/design-system",
  "version": "0.7.0",
  "description": "Design system Arquos \u2014 tokens partag\u00e9s (couleurs, typographie, spacing, radius) en TypeScript, CSS et JSON. Import\u00e9 par les apps mobile et web.",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./web.ts",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.tailwind.css": "./dist/tokens.tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./catalog.json": "./dist/catalog.json",
    "./components/*": "./components/*"
  },
  "files": [
    "src",
    "dist",
    "components",
    "web.ts",
    "README.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "node scripts/build-tokens.mjs && node scripts/build-catalog.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "check": "node scripts/build-tokens.mjs --check && node scripts/build-catalog.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Arquosdev/design-system.git"
  },
  "license": "UNLICENSED",
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
