{
  "name": "@arquos/design-system",
  "version": "2.10.3",
  "description": "Un design system pensé pour les agents — les règles d'usage vivent dans le dépôt, pas dans les têtes. Tokens et composants partagés par les apps mobile et web d'Arquos.",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./web.ts",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.tailwind.css": "./dist/tokens.tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./catalog.json": "./dist/catalog.json",
    "./components/*": "./components/*"
  },
  "files": [
    "src",
    "dist",
    "components",
    "web.ts",
    "README.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "node scripts/build-tokens.mjs && node scripts/build-catalog.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "check": "tsc --noEmit && node scripts/check-version.mjs && node scripts/build-tokens.mjs --check && node scripts/build-catalog.mjs --check && node scripts/check-contraste.mjs && npm run test --silent",
    "storybook": "storybook dev -p 6006",
    "vitrine": "storybook build -o dist-vitrine",
    "contraste": "node scripts/check-contraste.mjs",
    "types": "tsc --noEmit",
    "version-libre": "node scripts/check-version.mjs",
    "contraste-rendu": "node scripts/check-contraste-rendu.mjs",
    "test": "node --test --experimental-strip-types \"components/**/*.logic.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Arquosdev/design-system.git"
  },
  "license": "UNLICENSED",
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "phosphor-react-native": "^3.0.6",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "peerDependenciesMeta": {
    "@phosphor-icons/react": {
      "optional": true
    },
    "phosphor-react-native": {
      "optional": true
    }
  }
}
